#usda 1.0
(
    defaultPrim = "tender"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "tender"
{
    def Scope "Looks"
    {
        def Material "cast_physics" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.5
            float physics:restitution = 0
            float physics:staticFriction = 0.6
        }

        def Material "rubber_physics" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.8
            float physics:restitution = 0
            float physics:staticFriction = 0.9
        }

        def Material "steel_physics" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.4
            float physics:restitution = 0
            float physics:staticFriction = 0.5
        }

        def Material "steel"
        {
            token outputs:surface.connect = </tender/Looks/steel/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.45, 0.46, 0.48)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "rubber"
        {
            token outputs:surface.connect = </tender/Looks/rubber/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.05, 0.05, 0.05)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "cast_blue"
        {
            token outputs:surface.connect = </tender/Looks/cast_blue/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.25, 0.7)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "cast_red"
        {
            token outputs:surface.connect = </tender/Looks/cast_red/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.72, 0.08, 0.07)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }
    }

    def Scope "Geometry"
    {
        def Xform "post" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsArticulationRootAPI", "PhysicsMassAPI"]
        )
        {
            point3f physics:centerOfMass = (0, 0, 0.1)
            float3 physics:diagonalInertia = (0.1, 0.1, 0.1)
            float physics:mass = 5
            quatf physics:principalAxes = (1, 0, 0, 0)
            custom bool physxArticulation:enabledSelfCollisions = 0
            quatf xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

            def Cube "post" (
                prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
            )
            {
                rel material:binding = </tender/Looks/steel>
                rel material:binding:physics = </tender/Looks/steel_physics> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                color3f[] primvars:displayColor = [(0.45, 0.46, 0.48)]
                double size = 1
                quatf xformOp:orient = (1, 0, 0, 0)
                float3 xformOp:scale = (0.03, 0.03, 0.233)
                double3 xformOp:translate = (0, 0, 0.1185)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }
        }

