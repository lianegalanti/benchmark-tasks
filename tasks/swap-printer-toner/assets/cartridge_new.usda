#usda 1.0
(
    defaultPrim = "cartridge"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "cartridge" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    point3f physics:centerOfMass = (0, 0, -0.005)
    float3 physics:diagonalInertia = (0.0072158333, 0.0010558333, 0.0073266667)
    float physics:mass = 0.7
    quatf physics:principalAxes = (1, 0, 0, 0)

    def Scope "Looks"
    {
        def Material "body"
        {
            token outputs:surface.connect = </cartridge/Looks/body/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.06, 0.06, 0.07)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "handle"
        {
            token outputs:surface.connect = </cartridge/Looks/handle/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.95, 0.45, 0.05)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }
    }

    def Cube "body" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </cartridge/Looks/body>
        color3f[] primvars:displayColor = [(0.06, 0.06, 0.07)]
        double size = 1
        token visibility = "invisible"
        float3 xformOp:scale = (0.1, 0.34, 0.09)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "handle" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </cartridge/Looks/handle>
        color3f[] primvars:displayColor = [(0.95, 0.45, 0.05)]
        double size = 1
        float xformOp:rotateY = -30
        float3 xformOp:scale = (0.014, 0.16, 0.024)
        double3 xformOp:translate = (-0.034, 0, 0.079)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateY", "xformOp:scale"]
    }

    def Cube "post_left" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
