#usda 1.0
(
    defaultPrim = "ukulele"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "ukulele" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    point3f physics:centerOfMass = (0, 0, 0)
    float3 physics:diagonalInertia = (0.004, 0.0005, 0.004)
    bool physics:kinematicEnabled = 1
    float physics:mass = 0.35
    quatf physics:principalAxes = (1, 0, 0, 0)

    def Scope "Looks"
    {
        def Material "mahogany"
        {
            token outputs:surface.connect = </ukulele/Looks/mahogany/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.5, 0.28, 0.14)
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "rosewood"
        {
            token outputs:surface.connect = </ukulele/Looks/rosewood/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.2, 0.12, 0.08)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "nickel"
        {
            token outputs:surface.connect = </ukulele/Looks/nickel/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.8, 0.76)
                float inputs:roughness = 0.25
                token outputs:surface
            }
        }

        def Material "bone"
        {
            token outputs:surface.connect = </ukulele/Looks/bone/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.93, 0.9, 0.8)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "dark"
        {
            token outputs:surface.connect = </ukulele/Looks/dark/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.04, 0.03, 0.03)
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }

        def Material "pearl"
        {
            token outputs:surface.connect = </ukulele/Looks/pearl/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.92, 0.9, 0.86)
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "foam"
        {
            token outputs:surface.connect = </ukulele/Looks/foam/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.12, 0.12, 0.13)
                float inputs:roughness = 0.95
                token outputs:surface
            }
        }

        def Material "chrome"
        {
            token outputs:surface.connect = </ukulele/Looks/chrome/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.7, 0.7, 0.72)
                float inputs:roughness = 0.2
                token outputs:surface
            }
        }

        def Material "string"
        {
            token outputs:surface.connect = </ukulele/Looks/string/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.95, 0.94, 0.88)
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "wood_physics" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.4
            float physics:restitution = 0
            float physics:staticFriction = 0.45
        }

        def Material "fret_physics" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.25
            float physics:restitution = 0
            float physics:staticFriction = 0.3
        }

        def Material "foam_physics" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.8
            float physics:restitution = 0
            float physics:staticFriction = 0.9
        }

        def Material "string_physics" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.18
            float physics:restitution = 0
            float physics:staticFriction = 0.22
            custom token physxMaterial:frictionCombineMode = "min"
        }
    }

    def Cube "fingerboard0" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </ukulele/Looks/rosewood>
        rel material:binding:physics = </ukulele/Looks/wood_physics> (
            bindMaterialAs = "weakerThanDescendants"
        )
        color3f[] primvars:displayColor = [(0.2, 0.12, 0.08)]
        double size = 1
        float3 xformOp:scale = (0.0355, 0.025625, 0.005)
        double3 xformOp:translate = (0, -0.0128125, -0.0025)
