#usda 1.0
(
    defaultPrim = "manikin"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "manikin"
{
    def Scope "Looks"
    {
        def Material "skin"
        {
            token outputs:surface.connect = </manikin/Looks/skin/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.86, 0.7, 0.6)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "lip"
        {
            token outputs:surface.connect = </manikin/Looks/lip/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.72, 0.42, 0.4)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "dark"
        {
            token outputs:surface.connect = </manikin/Looks/dark/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.12, 0.08, 0.07)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "gown"
        {
            token outputs:surface.connect = </manikin/Looks/gown/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.45, 0.62, 0.72)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "skin_physics" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.5
            float physics:restitution = 0
            float physics:staticFriction = 0.6
        }
    }

    def Scope "Geometry"
    {
        def Xform "base" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsArticulationRootAPI", "PhysicsMassAPI"]
        )
        {
            point3f physics:centerOfMass = (0, 0, 0.05)
            float3 physics:diagonalInertia = (0.1, 0.06, 0.12)
            float physics:mass = 8
            quatf physics:principalAxes = (1, 0, 0, 0)
            custom bool physxArticulation:enabledSelfCollisions = 0
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]

            def Cube "bust" (
                prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
            )
            {
                rel material:binding = </manikin/Looks/gown>
                rel material:binding:physics = </manikin/Looks/skin_physics> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                color3f[] primvars:displayColor = [(0.45, 0.62, 0.72)]
                double size = 1
                float3 xformOp:scale = (0.19, 0.4, 0.085)
                double3 xformOp:translate = (0.012, 0, 0.0425)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }

            def Cube "trapezius" (
                prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
            )
            {
                rel material:binding = </manikin/Looks/gown>
                rel material:binding:physics = </manikin/Looks/skin_physics> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                color3f[] primvars:displayColor = [(0.45, 0.62, 0.72)]
                double size = 1
                float3 xformOp:scale = (0.15, 0.24, 0.035)
                double3 xformOp:translate = (0.02, 0, 0.10250000000000001)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }

            def Capsule "shoulders" (
                prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
            )
            {
                uniform token axis = "Y"
                double height = 0.31
                rel material:binding = </manikin/Looks/gown>
                rel material:binding:physics = </manikin/Looks/skin_physics> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                color3f[] primvars:displayColor = [(0.45, 0.62, 0.72)]
                double radius = 0.045
                double3 xformOp:translate = (0.012, 0, 0.065)
                uniform token[] xformOpOrder = ["xformOp:translate"]
            }

            def Cylinder "neck" (
                prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
            )
            {
                uniform token axis = "Z"
                double height = 0.11499999999999999
                rel material:binding = </manikin/Looks/skin>
                rel material:binding:physics = </manikin/Looks/skin_physics> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                color3f[] primvars:displayColor = [(0.86, 0.7, 0.6)]
                double radius = 0.055
                double3 xformOp:translate = (0.01, 0, 0.1575)
                uniform token[] xformOpOrder = ["xformOp:translate"]
            }

            def Xform "neck_link" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            )
            {
                point3f physics:centerOfMass = (0, 0, 0)
                float3 physics:diagonalInertia = (0.0001, 0.0001, 0.0001)
                float physics:mass = 0.1
                quatf physics:principalAxes = (1, 0, 0, 0)
                double3 xformOp:translate = (0, 0, 0.2)
                uniform token[] xformOpOrder = ["xformOp:translate"]

                def Xform "head" (
