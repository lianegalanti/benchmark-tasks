#usda 1.0
(
    defaultPrim = "tube"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "tube" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    point3f physics:centerOfMass = (0, 0, -0.12)
    float3 physics:diagonalInertia = (0.001, 0.001, 0.001)
    float physics:mass = 0.15
    quatf physics:principalAxes = (1, 0, 0, 0)

    def Scope "Looks"
    {
        def Material "tube"
        {
            token outputs:surface.connect = </tube/Looks/tube/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.84, 0.86)
                float inputs:opacity = 0.55
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "rack"
        {
            token outputs:surface.connect = </tube/Looks/rack/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.92, 0.92, 0.92)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "plastic_physics" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.35
            float physics:restitution = 0
            float physics:staticFriction = 0.4
        }
    }

    def Cube "wall_00" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </tube/Looks/tube>
        rel material:binding:physics = </tube/Looks/plastic_physics> (
            bindMaterialAs = "weakerThanDescendants"
        )
        color3f[] primvars:displayColor = [(0.8, 0.84, 0.86)]
        double size = 1
        float3 xformOp:scale = (0.0015, 0.0043982295, 0.15)
        double3 xformOp:translate = (0.007, 0, -0.075)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "wall_01" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
