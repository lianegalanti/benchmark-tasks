            bindMaterialAs = "weakerThanDescendants"
        )
        color3f[] primvars:displayColor = [(0.8, 0.84, 0.86)]
        double size = 1
        quatf xformOp:orient = (0.9659258, 0, 0, 0.25881904)
        float3 xformOp:scale = (0.0015, 0.0043982295, 0.15)
