                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }

            def Cylinder "core" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                uniform token axis = "Z"
                double height = 0.105
                rel material:binding = </driver/Looks/black>
                color3f[] primvars:displayColor = [(0.12, 0.12, 0.13)]
                double radius = 0.011999999999999999
                double3 xformOp:translate = (0, 0, 0.10250000000000001)
                uniform token[] xformOpOrder = ["xformOp:translate"]
            }

            def Cylinder "cap" (
                prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
            )
            {
                uniform token axis = "Z"
                double height = 0.015000000000000013
                rel material:binding = </driver/Looks/chrome>
                rel material:binding:physics = </driver/Looks/hard_physics> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                color3f[] primvars:displayColor = [(0.78, 0.79, 0.8)]
                double radius = 0.0195
                double3 xformOp:translate = (0, 0, 0.1625)
                uniform token[] xformOpOrder = ["xformOp:translate"]
            }

            def Xform "slider" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            )
            {
                point3f physics:centerOfMass = (0, 0, 0.04)
                float3 physics:diagonalInertia = (0.000002, 0.000002, 0.000002)
                float physics:mass = 0.02
                quatf physics:principalAxes = (1, 0, 0, 0)
                double3 xformOp:translate = (0, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate"]

                def Xform "anvil" (
                    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                )
                {
                    point3f physics:centerOfMass = (0, 0, 0.035)
                    float3 physics:diagonalInertia = (0.00002, 0.00002, 0.000008)
                    float physics:mass = 0.13
                    quatf physics:principalAxes = (1, 0, 0, 0)
                    double3 xformOp:translate = (0, 0, 0)
                    uniform token[] xformOpOrder = ["xformOp:translate"]

