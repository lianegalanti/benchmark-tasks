#usda 1.0
(
    defaultPrim = "driver"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "driver"
{
    def Scope "Looks"
    {
        def Material "black"
        {
            token outputs:surface.connect = </driver/Looks/black/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.12, 0.12, 0.13)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "chrome"
        {
            token outputs:surface.connect = </driver/Looks/chrome/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.78, 0.79, 0.8)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "knurl_physics" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.8
            float physics:restitution = 0
            float physics:staticFriction = 0.9
        }

        def Material "steel_physics" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.35
            float physics:restitution = 0
            float physics:staticFriction = 0.4
        }

        def Material "hard_physics" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.15
            float physics:restitution = 0
            float physics:staticFriction = 0.2
        }
    }

    def Scope "Geometry"
    {
        def Xform "body" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsArticulationRootAPI", "PhysxContactReportAPI", "PhysicsMassAPI"]
        )
        {
            point3f physics:centerOfMass = (0, 0, 0.11)
            float3 physics:diagonalInertia = (0.0006405, 0.0006405, 0.000081)
            float physics:mass = 0.5
            quatf physics:principalAxes = (1, 0, 0, 0)
            custom bool physxArticulation:enabledSelfCollisions = 0
            custom float physxContactReport:threshold = 0
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]

            def Cube "facet_0" (
                prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
            )
            {
                rel material:binding = </driver/Looks/black>
                rel material:binding:physics = </driver/Looks/knurl_physics> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                color3f[] primvars:displayColor = [(0.12, 0.12, 0.13)]
                double size = 1
                float3 xformOp:scale = (0.006, 0.009839094, 0.105)
                double3 xformOp:translate = (0.015, 0, 0.10250000000000001)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }

            def Cube "facet_1" (
