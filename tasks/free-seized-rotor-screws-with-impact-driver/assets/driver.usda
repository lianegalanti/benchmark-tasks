    def Scope "Physics"
    {
        def PhysicsPrismaticJoint "stroke" (
            prepend apiSchemas = ["PhysicsDriveAPI:linear"]
        )
        {
            float drive:linear:physics:damping = 5
            float drive:linear:physics:maxForce = 1000
            float drive:linear:physics:stiffness = 5000
            float drive:linear:physics:targetPosition = -0.004
            uniform token drive:linear:physics:type = "force"
            uniform token physics:axis = "Z"
            rel physics:body0 = </driver/Geometry/body>
            rel physics:body1 = </driver/Geometry/body/slider>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            float physics:lowerLimit = 0
            float physics:upperLimit = 0.003
        }

        def PhysicsRevoluteJoint "cam" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 0.0034906585
            float drive:angular:physics:maxForce = 50
            float drive:angular:physics:stiffness = 0.34906584
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            uniform token physics:axis = "Z"
            rel physics:body0 = </driver/Geometry/body/slider>
            rel physics:body1 = </driver/Geometry/body/slider/anvil>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
        }
    }
