    def Scope "Physics"
    {
        def PhysicsRevoluteJoint "screw_a" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 0.017453292
            float drive:angular:physics:maxForce = 100
            float drive:angular:physics:stiffness = 0.87266463
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            uniform token physics:axis = "Z"
            rel physics:body0 = </hub/Geometry/base>
            rel physics:body1 = </hub/Geometry/base/screw_a>
            point3f physics:localPos0 = (0, 0.04, 0.105)
            point3f physics:localPos1 = (0, 0, 0)
        }

        def PhysicsFixedJoint "root_joint"
        {
            rel physics:body0 = </hub>
            rel physics:body1 = </hub/Geometry/base>
        }
    }
