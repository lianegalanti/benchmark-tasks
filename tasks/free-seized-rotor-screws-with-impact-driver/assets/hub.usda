#usda 1.0
(
    defaultPrim = "hub"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "hub"
{
    def Scope "Looks"
    {
        def Material "iron"
        {
            token outputs:surface.connect = </hub/Looks/iron/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.33, 0.32, 0.31)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "rust"
        {
            token outputs:surface.connect = </hub/Looks/rust/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.45, 0.28, 0.18)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "steel"
        {
            token outputs:surface.connect = </hub/Looks/steel/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.4, 0.41, 0.43)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "zinc"
        {
            token outputs:surface.connect = </hub/Looks/zinc/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.72, 0.71, 0.66)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "dark"
        {
            token outputs:surface.connect = </hub/Looks/dark/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.08, 0.08, 0.08)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "steel_physics" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.35
            float physics:restitution = 0
            float physics:staticFriction = 0.4
        }

        def Material "iron_physics" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.4
            float physics:restitution = 0
            float physics:staticFriction = 0.45
        }
    }

    def Scope "Geometry"
    {
        def Xform "base" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsArticulationRootAPI", "PhysicsMassAPI"]
        )
        {
            point3f physics:centerOfMass = (0, 0, 0.07)
            float3 physics:diagonalInertia = (0.05, 0.05, 0.08)
            float physics:mass = 9
            quatf physics:principalAxes = (1, 0, 0, 0)
            custom bool physxArticulation:enabledSelfCollisions = 0
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]

            def Cube "foot" (
                prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
            )
            {
                rel material:binding = </hub/Looks/steel>
                rel material:binding:physics = </hub/Looks/iron_physics> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                color3f[] primvars:displayColor = [(0.4, 0.41, 0.43)]
                double size = 1
                float3 xformOp:scale = (0.16, 0.16, 0.012)
                double3 xformOp:translate = (0, 0, 0.006)
