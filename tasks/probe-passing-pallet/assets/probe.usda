#usda 1.0
(
    defaultPrim = "Probe"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Probe" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxContactReportAPI"]
)
{
    float physics:mass = 0.06
    float physxContactReport:threshold = 0

    def Cube "handle" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        color3f[] primvars:displayColor = [(0.1, 0.1, 0.12)]
        double size = 1
        double3 xformOp:translate = (0.0, 0.0, 0.0)
        float3 xformOp:scale = (0.026, 0.026, 0.1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "tip" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        color3f[] primvars:displayColor = [(0.78, 0.6, 0.2)]
        double size = 1
        double3 xformOp:translate = (0.0, 0.0, -0.07)
        float3 xformOp:scale = (0.008, 0.008, 0.04)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}
