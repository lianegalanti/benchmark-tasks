#usda 1.0
(
    defaultPrim = "Peg"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Peg" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    float physics:mass = 0.11

    def Cylinder "shaft" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        uniform token axis = "Y"
        color3f[] primvars:displayColor = [(0.62, 0.63, 0.66)]
        double height = 0.07
        double radius = 0.008
    }
}
