#usda 1.0
(
    defaultPrim = "Knife"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Knife" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    float physics:mass = 0.09

    def Cube "handle" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        color3f[] primvars:displayColor = [(0.36, 0.2, 0.1)]
        double size = 1
        float3 xformOp:scale = (0.1, 0.024, 0.022)
        double3 xformOp:translate = (-0.05, 0, 0.011)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "blade" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        color3f[] primvars:displayColor = [(0.78, 0.8, 0.83)]
        double size = 1
        float3 xformOp:scale = (0.1, 0.028, 0.004)
        double3 xformOp:translate = (0.05, 0.002, 0.002)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "tip" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        color3f[] primvars:displayColor = [(0.78, 0.8, 0.83)]
        double size = 1
        float3 xformOp:scale = (0.02, 0.016, 0.004)
        double3 xformOp:translate = (0.11, -0.004, 0.002)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}

