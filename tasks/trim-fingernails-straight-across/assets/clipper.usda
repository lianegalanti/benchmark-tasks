        {
            point3f physics:centerOfMass = (0.03, 0, 0.001)
            float3 physics:diagonalInertia = (1e-7, 0.0000035, 0.0000035)
            prepend rel physics:filteredPairs = [
                </clipper/Geometry/body/upper>,
                </clipper/Geometry/body/lever>,
            ]
            float physics:mass = 0.012
