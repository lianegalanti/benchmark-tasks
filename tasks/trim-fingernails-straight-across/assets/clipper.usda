#usda 1.0
(
    defaultPrim = "clipper"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "clipper"
{
    def Scope "Looks"
    {
        def Material "steel"
        {
            token outputs:surface.connect = </clipper/Looks/steel/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.72, 0.73, 0.76)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "dark"
        {
            token outputs:surface.connect = </clipper/Looks/dark/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.45, 0.46, 0.48)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "steel_physics" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.45
            float physics:restitution = 0
            float physics:staticFriction = 0.5
        }

        def Material "lever_physics" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.8
            float physics:restitution = 0
            float physics:staticFriction = 0.9
        }
    }

