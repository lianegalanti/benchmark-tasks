            float drive:linear:physics:damping = 50
            float drive:linear:physics:maxForce = 100
            float drive:linear:physics:stiffness = 100000
            float drive:linear:physics:targetPosition = 0
            uniform token drive:linear:physics:type = "force"
            uniform token physics:axis = "X"
            rel physics:body0 = </hand/Geometry/palm/middle>
            rel physics:body1 = </hand/Geometry/palm/middle/middle_b7>
            point3f physics:localPos0 = (0.097, 0.00503125, 0.00725)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -0.0039109373
            float physics:upperLimit = 0
        }

        def PhysicsFixedJoint "root_joint"
        {
            rel physics:body0 = </hand>
            rel physics:body1 = </hand/Geometry/palm>
        }
    }
}

