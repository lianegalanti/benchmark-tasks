#usda 1.0
(
    defaultPrim = "spoon"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "spoon" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    point3f physics:centerOfMass = (0.025, 0, -0.001)
    float3 physics:diagonalInertia = (0.00000675, 0.00032544642, 0.00032544642)
    float physics:mass = 0.09
    quatf physics:principalAxes = (1, 0, 0, 0)

    def Scope "Looks"
    {
        def Material "handle"
        {
            token outputs:surface.connect = </spoon/Looks/handle/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.85, 0.12, 0.1)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "blade"
        {
            token outputs:surface.connect = </spoon/Looks/blade/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.7, 0.72, 0.74)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "grip_physics" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.9
            float physics:restitution = 0
            float physics:staticFriction = 1
        }

        def Material "steel_physics" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.35
            float physics:restitution = 0
            float physics:staticFriction = 0.4
        }
    }

    def Cube "handle" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </spoon/Looks/handle>
        rel material:binding:physics = </spoon/Looks/grip_physics> (
            bindMaterialAs = "weakerThanDescendants"
        )
        color3f[] primvars:displayColor = [(0.85, 0.12, 0.1)]
        double size = 1
        float3 xformOp:scale = (0.1, 0.024, 0.018)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "blade" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </spoon/Looks/blade>
        rel material:binding:physics = </spoon/Looks/steel_physics> (
            bindMaterialAs = "weakerThanDescendants"
        )
        color3f[] primvars:displayColor = [(0.7, 0.72, 0.74)]
        double size = 1
        float3 xformOp:scale = (0.125, 0.012, 0.0016)
        double3 xformOp:translate = (0.1125, 0, -0.008199999999999999)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}

