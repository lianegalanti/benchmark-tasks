#usda 1.0
(
    defaultPrim = "corner"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "corner"
{
    def Scope "Looks"
    {
        def Material "steel"
        {
            token outputs:surface.connect = </corner/Looks/steel/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.42, 0.43, 0.45)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "iron"
        {
            token outputs:surface.connect = </corner/Looks/iron/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.3, 0.29, 0.28)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "lining"
        {
            token outputs:surface.connect = </corner/Looks/lining/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.45, 0.33)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "bright"
        {
            token outputs:surface.connect = </corner/Looks/bright/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.75, 0.73, 0.68)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "brass"
        {
            token outputs:surface.connect = </corner/Looks/brass/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.62, 0.25)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "steel_physics" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.35
            float physics:restitution = 0
            float physics:staticFriction = 0.4
        }

        def Material "iron_physics" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.4
            float physics:restitution = 0
            float physics:staticFriction = 0.45
        }

        def Material "grip_physics" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.9
            float physics:restitution = 0
            float physics:staticFriction = 1
        }
    }

    def Scope "Geometry"
    {
        def Xform "base" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsArticulationRootAPI", "PhysicsMassAPI"]
        )
        {
            point3f physics:centerOfMass = (0, -0.02, -0.03)
            float3 physics:diagonalInertia = (0.15, 0.25, 0.15)
            float physics:mass = 12
            quatf physics:principalAxes = (1, 0, 0, 0)
            custom bool physxArticulation:enabledSelfCollisions = 0
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]

