        float3 xformOp:scale = (0.006, 0.228, 0.02)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "skirt_back" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        color3f[] primvars:displayColor = [(0.3, 0.52, 0.78)]
        double size = 1
        double3 xformOp:translate = (-0.091, 0.0, -0.01)
        float3 xformOp:scale = (0.006, 0.228, 0.02)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "skirt_left" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        color3f[] primvars:displayColor = [(0.3, 0.52, 0.78)]
        double size = 1
        double3 xformOp:translate = (0.0, 0.111, -0.01)
        float3 xformOp:scale = (0.176, 0.006, 0.02)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "skirt_right" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        color3f[] primvars:displayColor = [(0.3, 0.52, 0.78)]
        double size = 1
        double3 xformOp:translate = (0.0, -0.111, -0.01)
        float3 xformOp:scale = (0.176, 0.006, 0.02)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "handle" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        color3f[] primvars:displayColor = [(0.2, 0.22, 0.25)]
        double size = 1
        double3 xformOp:translate = (0.0, 0.0, 0.0295)
        float3 xformOp:scale = (0.08, 0.025, 0.035)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
