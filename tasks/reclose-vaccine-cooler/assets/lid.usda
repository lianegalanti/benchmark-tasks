#usda 1.0
(
    defaultPrim = "Lid"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Lid" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    float physics:mass = 0.2

    def Cube "plate" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        color3f[] primvars:displayColor = [(0.3, 0.52, 0.78)]
        double size = 1
        double3 xformOp:translate = (0.0, 0.0, 0.006)
        float3 xformOp:scale = (0.188, 0.228, 0.012)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "skirt_front" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
